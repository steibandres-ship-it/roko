SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Last.fm offers a free API key for non-commercial use. Keep it server-side.
LASTFM_API_KEY=
# Review https://www.last.fm/api/tos before confirming these scope flags.
# Usage outside the EEA is subject to an additional permission condition in the terms.
LASTFM_NONCOMMERCIAL_USE=false
LASTFM_NON_EEA_PERMISSION_CONFIRMED=false
LASTFM_MARKETS=CL,MX,AR,CO,ES,US,BR

# Soundcharts API is separate from the Soundcharts web dashboard.
# Current OAuth client-credentials flow; keep the secret server-side.
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_TEAM_ID=
# Non-secret verification metadata; maintained by `world soundcharts-check`.
SOUNDCHARTS_API_VERIFIED_AT=
SOUNDCHARTS_API_QUOTA_REMAINING=
# Free-only gate: set this only after activating Soundcharts' free 1,000-request API trial.
SOUNDCHARTS_ACCESS_MODE=
# Optional legacy credentials for existing integrations only.
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=
# Set true only after written permission covers stored metrics and playlist research.
SOUNDCHARTS_RIGHTS_CONFIRMED=false

# Chartmetric API credentials are separate from a free dashboard login.
CHARTMETRIC_REFRESH_TOKEN=
# Free-only gate: Chartmetric advertises a no-card 7-day API trial. Do not use paid dashboard plans or metered credits.
# Never set dates until the API trial is manually activated and the actual UTC window is known.
CHARTMETRIC_ACCESS_MODE=
CHARTMETRIC_FREE_TRIAL_STARTED_AT=
CHARTMETRIC_FREE_TRIAL_ENDS_AT=
# Set true only after written permission covers snapshots, derived scores, and playlist curation.
CHARTMETRIC_RIGHTS_CONFIRMED=false
CHARTMETRIC_MARKETS=CL,MX,AR,CO,ES,US,BR

# Separate process -> local API bridge. Put a random secret of at least 32 chars
# in .env; never commit or share it. The receiver binds to localhost by default.
WORLD_MUSIC_INGEST_API_TOKEN=
WORLD_MUSIC_INGEST_API_URL=http://127.0.0.1:8002
SOUNDCHARTS_CHART_SLUGS=
WORLD_MUSIC_BRIDGE_LIMIT=100
WORLD_MUSIC_BRIDGE_MAX_REQUESTS=40

# External bridge request bounds; CLI flags override these values.
# Keep the Soundcharts chart list explicit to control API quota usage.
# The Last.fm and Chartmetric market lists above are reused by the bridge.

# Optional. Defaults to local SQLite at data/world_music_os.sqlite3.
# WORLD_MUSIC_DATABASE_URL=postgresql+psycopg://world_music:change_me@localhost:5432/world_music_os
